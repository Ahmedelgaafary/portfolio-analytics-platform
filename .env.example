# ==========================================
# Portfolio Analytics Platform
# Environment Configuration
# ==========================================

# Application
APP_NAME=Portfolio Analytics Platform
APP_VERSION=1.0.0

# Database
DATABASE_PATH=data/database.db

# Market Data
DEFAULT_START_DATE=2018-01-01
DEFAULT_END_DATE=2025-01-01
DEFAULT_INTERVAL=1d

# Portfolio
RISK_FREE_RATE=0.02
TRADING_DAYS=252
DEFAULT_OPTIMIZER=maximum_sharpe
FRONTIER_POINTS=100

# Machine Learning
TEST_SIZE=0.20
RANDOM_STATE=42

# Logging
LOG_LEVEL=INFO
LOG_FILE=portfolio.log